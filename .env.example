# The only operator-edited configuration file. See docs/configuration.md.
# Bootstrap token: repository creation, contents/workflows, issues/PRs, Actions/secrets.
# Never copied to Actions or Instacloud. Prefer a dedicated token/account.
FULLBEAM_GITHUB_TOKEN=
FULLBEAM_DEMO_REPOSITORY=
# Optional normal-operation repository; defaults to the demo repository.
FULLBEAM_REPOSITORY=
FULLBEAM_INSTACLOUD_API_TOKEN=
INSTA_ORG_ID=
FULLBEAM_INSTACLOUD_REGION=
OPENAI_API_KEY=
# Dashboard persistence: real InstaCloud Postgres. Setup can provision this
# in FULLBEAM_INSTACLOUD_PROJECT_ID and fill DATABASE_URL in this same file.
FULLBEAM_INSTACLOUD_PROJECT_ID=
DATABASE_URL=
# Initial release default; later experiments use harness propose --model.
# Use a model available to your API account. No invented model default.
FULLBEAM_MODEL=
# Optional: medium is frozen into both initial harness releases.
FULLBEAM_REASONING_EFFORT=medium
# Owned demo runs without prompts; reviewed requires explicit human approvals.
FULLBEAM_DEMO_MODE=automated
# Optional default-model estimates: USD per million tokens. Blank uses the
# verified catalog when available; otherwise cost remains UNKNOWN.
FULLBEAM_INPUT_USD_PER_MILLION=
FULLBEAM_CACHED_INPUT_USD_PER_MILLION=
FULLBEAM_OUTPUT_USD_PER_MILLION=
# Optional stop-scheduling threshold; requires complete matching rate data.
FULLBEAM_MAX_MODEL_COST_USD=
# Optional per-model overrides (USD / million tokens), e.g. {"gpt-5.6-sol":{"input":4,"cached":0.4,"output":20}}
# Verified standard rates for Sol, Astra, and Luna are built in; overrides win.
FULLBEAM_MODEL_RATES_JSON=
